# LiveKit project credentials (from your LiveKit Cloud project or local dev server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM / STT / TTS providers used by agent.py
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Where the FastAPI backend is running
BACKEND_URL=http://localhost:8000
